<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Biblioteca Digital UNTEC</display-name>
    <description>Sistema Web Dinámico para la gestión de biblioteca digital universitaria en Java EE</description>

    <!-- Welcome Files -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Filtro de Autenticación y Autorización -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>cl.untec.biblioteca.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Configuración de Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>cl.untec.biblioteca.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>cl.untec.biblioteca.controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LibroServlet</servlet-name>
        <servlet-class>cl.untec.biblioteca.controller.LibroServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LibroServlet</servlet-name>
        <url-pattern>/libros</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PrestamoServlet</servlet-name>
        <servlet-class>cl.untec.biblioteca.controller.PrestamoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PrestamoServlet</servlet-name>
        <url-pattern>/prestamos</url-pattern>
    </servlet-mapping>

    <!-- Timeout de Sesión (en minutos) -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <!-- Páginas de Error Personalizadas -->
    <error-page>
        <error-code>404</error-code>
        <location>/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error/500.jsp</location>
    </error-page>

</web-app>
